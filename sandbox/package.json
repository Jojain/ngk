{
  "name": "ngk-sandbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "cd .. && wasm-pack build --target web --out-dir sandbox/src/wasm --features wasm",
    "dev": "npm run wasm:build && vite",
    "build": "npm run wasm:build && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@ngk/viewer": "file:../viewer",
    "@react-three/drei": "^9.112.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.2",
    "vite": "^5.4.8",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0"
  }
}
