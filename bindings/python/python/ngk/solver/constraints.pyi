from typing import ClassVar, Self

from . import CircularId, GeometryId, PointLike, SegmentId

class TangencyMode:
    Automatic: ClassVar[TangencyMode]
    External: ClassVar[TangencyMode]
    Internal: ClassVar[TangencyMode]
    FirstContainsSecond: ClassVar[TangencyMode]
    SecondContainsFirst: ClassVar[TangencyMode]
    def __int__(self) -> int: ...

class Constraint: ...

class Coincident(Constraint):
    __match_args__ = ("first", "second")
    def __new__(cls, first: PointLike, second: PointLike) -> Self: ...
    @property
    def first(self) -> PointLike: ...
    @property
    def second(self) -> PointLike: ...

class PointOnLine(Constraint):
    __match_args__ = ("point", "line")
    def __new__(cls, point: PointLike, line: SegmentId) -> Self: ...
    @property
    def point(self) -> PointLike: ...
    @property
    def line(self) -> SegmentId: ...

class PointOnCircle(Constraint):
    __match_args__ = ("point", "circle")
    def __new__(cls, point: PointLike, circle: CircularId) -> Self: ...
    @property
    def point(self) -> PointLike: ...
    @property
    def circle(self) -> CircularId: ...

class Horizontal(Constraint):
    __match_args__ = ("line",)
    def __new__(cls, line: SegmentId) -> Self: ...
    @property
