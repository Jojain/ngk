from enum import Enum

from ..geometry import Point2, Vector2
from . import constraints as constraints
from .constraints import Constraint, TangencyMode

class PointRef: ...

class PointId:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...

class SegmentId:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...
    def start(self) -> PointRef: ...
    def end(self) -> PointRef: ...

class CircleId:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...
    def center(self) -> PointRef: ...

class ArcId:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...
    def start(self) -> PointRef: ...
    def end(self) -> PointRef: ...
    def center(self) -> PointRef: ...

class ConstraintId:
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...

type GeometryId = PointId | SegmentId | CircleId | ArcId
type CircularId = CircleId | ArcId
type CurveId = SegmentId | CircleId | ArcId
type PointLike = PointRef | PointId

class Segment2:
    def __init__(self, start: Point2, end: Point2) -> None: ...
    @property
    def start(self) -> Point2: ...
    @property
    def end(self) -> Point2: ...
    @property
    def length(self) -> float: ...

class Arc2:
    def __init__(self, center: Point2, x_dir: Vector2, radius: float, sweep: float) -> None: ...
    @property
    def center(self) -> Point2: ...
    @property
    def radius(self) -> float: ...
    @property
    def sweep(self) -> float: ...
    @property
    def start(self) -> Point2: ...
    @property
    def end(self) -> Point2: ...
    @property
    def length(self) -> float: ...

class Circle2:
    def __init__(self, center: Point2, radius: float) -> None: ...
    @property
    def center(self) -> Point2: ...
    @property
    def radius(self) -> float: ...

class Target: ...

class PointTarget(Target):
    def __init__(self, point: PointLike, position: Point2, weight: float = 1.0) -> None: ...

class SegmentTarget(Target):
    def __init__(self, segment: SegmentId, fraction: float, position: Point2, weight: float = 1.0) -> None: ...

class ArcTarget(Target):
    def __init__(self, arc: ArcId, fraction: float, position: Point2, weight: float = 1.0) -> None: ...

class CircleTarget(Target):
    def __init__(self, circle: CircleId, angle: float, position: Point2, weight: float = 1.0) -> None: ...

class RedundancyKind(Enum):
    Duplicate = ...
    LocalDependency = ...
    PartialLocalDependency = ...

class Redundancy:
    @property
    def constraint(self) -> ConstraintId: ...
    @property
    def kind(self) -> RedundancyKind: ...

class ConstraintResidual:
    @property
    def constraint(self) -> ConstraintId: ...
    @property
    def values(self) -> list[float]: ...
    @property
    def max_tolerance_ratio(self) -> float: ...

class TargetReport:
    @property
    def index(self) -> int: ...
    @property
    def achieved(self) -> Point2: ...
    @property
    def distance(self) -> float: ...
    @property
    def reached(self) -> bool: ...

class SolveReport:
    @property
    def degrees_of_freedom(self) -> int: ...
    def freedom(self, primitive: GeometryId) -> int | None: ...
    @property
    def freedoms(self) -> dict[GeometryId, int]: ...
    @property
    def redundancies(self) -> list[Redundancy]: ...
    @property
    def residuals(self) -> list[ConstraintResidual]: ...
    @property
    def targets(self) -> list[TargetReport]: ...
    @property
    def tangencies(self) -> list[tuple[ConstraintId, TangencyMode]]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def target_iterations(self) -> int: ...
    @property
    def target_budget_exhausted(self) -> bool: ...

class Solution2d:
    def point(self, point: PointLike) -> Point2: ...
    def segment(self, id: SegmentId) -> Segment2: ...
    def circle(self, id: CircleId) -> Circle2: ...
    def arc(self, id: ArcId) -> Arc2: ...
    @property
    def report(self) -> SolveReport: ...

class System2d:
    def __init__(self) -> None: ...
    def add_point(self, point: Point2) -> PointId: ...
    def add_segment(self, segment: Segment2) -> SegmentId: ...
    def add_circle(self, circle: Circle2) -> CircleId: ...
    def add_arc(self, arc: Arc2) -> ArcId: ...
    def add_constraint(self, constraint: Constraint) -> ConstraintId: ...
    def insert_point(self, id: PointId, point: Point2) -> None: ...
    def insert_segment(self, id: SegmentId, segment: Segment2) -> None: ...
    def insert_circle(self, id: CircleId, circle: Circle2) -> None: ...
    def insert_arc(self, id: ArcId, arc: Arc2) -> None: ...
    def insert_constraint(self, id: ConstraintId, constraint: Constraint) -> None: ...
    def update_point(self, id: PointId, point: Point2) -> None: ...
    def update_segment(self, id: SegmentId, segment: Segment2) -> None: ...
    def update_circle(self, id: CircleId, circle: Circle2) -> None: ...
    def update_arc(self, id: ArcId, arc: Arc2) -> None: ...
    def update_constraint(self, id: ConstraintId, constraint: Constraint) -> None: ...
    def remove_constraint(self, id: ConstraintId) -> None: ...
    def remove_geometry(self, id: GeometryId) -> None: ...
    def remove_cascade(self, id: GeometryId) -> list[ConstraintId]: ...
    def constraint(self, id: ConstraintId) -> Constraint: ...
    def point(self, point: PointLike) -> Point2: ...
    def segment(self, id: SegmentId) -> Segment2: ...
    def circle(self, id: CircleId) -> Circle2: ...
    def arc(self, id: ArcId) -> Arc2: ...
    @property
    def geometry_count(self) -> int: ...
    @property
    def constraint_count(self) -> int: ...
    def solve(self) -> Solution2d: ...
    def solve_toward(self, targets: list[Target]) -> Solution2d: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> System2d: ...

class ConflictError(ValueError):
    constraints: list[ConstraintId]

class NonConvergenceError(ValueError):
    constraints: list[ConstraintId]
    residuals: list[ConstraintResidual]
