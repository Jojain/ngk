from typing import ClassVar, Literal, Self

from ..geometry import Frame, Point, Rigid

class BodyId:
    def __new__(cls, value: int) -> Self: ...
    @property
    def value(self) -> int: ...

class JointId:
    def __new__(cls, value: int) -> Self: ...
    @property
    def value(self) -> int: ...

class JointKind:
    Fixed: ClassVar[JointKind]
    Revolute: ClassVar[JointKind]
    Prismatic: ClassVar[JointKind]
    Helical: ClassVar[JointKind]
    Cylindrical: ClassVar[JointKind]
    Universal: ClassVar[JointKind]
    Spherical: ClassVar[JointKind]
    Planar: ClassVar[JointKind]
    CylinderOnPlane: ClassVar[JointKind]
    SphereInCylinder: ClassVar[JointKind]
    SphereOnPlane: ClassVar[JointKind]

class Coordinate:
    Angle: ClassVar[Coordinate]
    Slide: ClassVar[Coordinate]
    X: ClassVar[Coordinate]
    Y: ClassVar[Coordinate]
    Roll: ClassVar[Coordinate]
    Alpha: ClassVar[Coordinate]
    Beta: ClassVar[Coordinate]

class Limit:
    def __new__(cls, min: float | None = None, max: float | None = None) -> Self: ...
    @property
    def min(self) -> float | None: ...
    @property
    def max(self) -> float | None: ...

class Attachment:
    def __new__(cls, body: BodyId, frame: Frame) -> Self: ...
    @property
    def body(self) -> BodyId: ...
    @property
    def frame(self) -> Frame: ...

class Joint:
    def __new__(
        cls,
        kind: JointKind,
        first: Attachment,
        second: Attachment,
        *,
        pitch: float | None = None,
        values: dict[Coordinate, float] | None = None,
        limits: dict[Coordinate, Limit] | None = None,
        cone: float | None = None,
    ) -> Self: ...
    @property
    def kind(self) -> JointKind: ...
    @property
    def pitch(self) -> float | None: ...
    @property
    def first(self) -> Attachment: ...
    @property
    def second(self) -> Attachment: ...
    @property
    def values(self) -> dict[Coordinate, float]: ...
    @property
    def limits(self) -> dict[Coordinate, Limit]: ...
    @property
    def cone(self) -> float | None: ...

class Target:
    def __new__(
        cls, body: BodyId, point: Point, position: Point, weight: float = 1.0
    ) -> Self: ...

class ActiveLimit:
    @property
    def joint(self) -> JointId: ...
    @property
    def side(self) -> Literal["min", "max", "cone"]: ...
    @property
    def coordinate(self) -> Coordinate | None: ...

class JointResidual:
    @property
    def joint(self) -> JointId: ...
    @property
    def values(self) -> list[float]: ...
    @property
    def max_tolerance_ratio(self) -> float: ...

class TargetReport:
    @property
    def index(self) -> int: ...
    @property
    def achieved(self) -> Point: ...
    @property
    def distance(self) -> float: ...
    @property
    def reached(self) -> bool: ...

class SolveReport:
    @property
    def mobility(self) -> int: ...
    @property
    def redundancy(self) -> int: ...
    @property
    def freedoms(self) -> dict[BodyId, int]: ...
    @property
    def redundancies(self) -> dict[JointId, int]: ...
    @property
    def active_limits(self) -> list[ActiveLimit]: ...
    @property
    def residuals(self) -> list[JointResidual]: ...
    @property
    def targets(self) -> list[TargetReport]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def target_iterations(self) -> int: ...
    @property
    def target_budget_exhausted(self) -> bool: ...

class Solution3d:
    def pose(self, body: BodyId) -> Rigid: ...
    def coordinate(self, joint: JointId, coordinate: Coordinate) -> float: ...
    def relative(self, joint: JointId) -> Rigid: ...
    @property
    def report(self) -> SolveReport: ...

class Assembly3d:
    def __new__(cls) -> Self: ...
    def add_body(self, seed: Rigid) -> BodyId: ...
    def insert_body(self, id: BodyId, seed: Rigid) -> None: ...
    def body(self, id: BodyId) -> Rigid: ...
    def update_body(self, id: BodyId, seed: Rigid) -> None: ...
    def fix(self, id: BodyId) -> None: ...
    def unfix(self, id: BodyId) -> None: ...
    def fixing(self, id: BodyId) -> Rigid | None: ...
    def remove_body(self, id: BodyId) -> None: ...
    def remove_cascade(self, id: BodyId) -> list[JointId]: ...
    def add_joint(self, joint: Joint) -> JointId: ...
    def insert_joint(self, id: JointId, joint: Joint) -> None: ...
    def joint(self, id: JointId) -> Joint: ...
    def update_joint(self, id: JointId, joint: Joint) -> None: ...
    def remove_joint(self, id: JointId) -> None: ...
    def set_coordinate_seed(
        self, id: JointId, coordinate: Coordinate, value: float
    ) -> None: ...
    def coordinate_seed(self, id: JointId, coordinate: Coordinate) -> float | None: ...
    @property
    def body_count(self) -> int: ...
    @property
    def joint_count(self) -> int: ...
    def solve(self) -> Solution3d: ...
    def solve_toward(self, targets: list[Target]) -> Solution3d: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> Assembly3d: ...

class NonConvergenceError(ValueError):
    joints: list[JointId]
    residuals: list[JointResidual]

class LimitError(ValueError):
    limit: ActiveLimit
