class Model:
    @staticmethod
    def deserialize(serialized: str) -> Model: ...
    def serialize(self) -> str: ...
    @property
    def dimension(self) -> int: ...
    @property
    def involution_count(self) -> int: ...
    @property
    def dart_count(self) -> int: ...
    def darts(self) -> list[int]: ...
    def alpha(self, dimension: int, dart: int) -> int: ...
    def is_free(self, dimension: int, dart: int) -> bool: ...
    def orbit(self, dart: int, involutions: list[int]) -> list[int]: ...
    def cells(self, dimension: int) -> list[int]: ...
    def cell_darts(self, dart: int, dimension: int) -> list[int]: ...
    def cell_representative(self, dart: int, dimension: int) -> int: ...
    def incident_cells(self, dart: int, container_dimension: int, target_dimension: int) -> list[int]: ...
    def adjacent_cells(self, dart: int, dimension: int) -> list[int]: ...
    def vertices(self) -> list[Vertex]: ...
    def edges(self) -> list[Edge]: ...
    def profiles(self) -> list[Profile]: ...
    def faces(self) -> list[Face]: ...
    def sheets(self) -> list[Sheet]: ...
    def solids(self) -> list[Solid]: ...
    # The entity a dart belongs to, or None when it belongs to none of that kind.
    def vertex(self, dart: int) -> Vertex | None: ...
    def edge(self, dart: int) -> Edge | None: ...
    def profile(self, dart: int) -> Profile | None: ...
    def face(self, dart: int) -> Face | None: ...
    def sheet(self, dart: int) -> Sheet | None: ...
    def solid(self, dart: int) -> Solid | None: ...

class _Topology:
    @property
    def model(self) -> Model: ...
    @property
    def key(self) -> str: ...
    @property
    def dart_id(self) -> int | None: ...

class Vertex(_Topology):
    def isolated(self) -> Self: ...
    @property
    def point(self) -> Point | None: ...
    def edges(self) -> list[Edge]: ...
    def faces(self) -> list[Face]: ...
    def sheets(self) -> list[Sheet]: ...

class Edge(_Topology):
    def project(
        self,
        source: Point | tuple[float, float, float],
        tolerance: float | None = None,
    ) -> PointProjection: ...
    def isolated(self) -> Self: ...
    def reversed(self) -> Self: ...
    @property
    def start(self) -> Vertex: ...
    @property
    def end(self) -> Vertex: ...
    @property
    def length(self) -> float | None: ...
    @property
    def curve(self) -> _Curve | None: ...
    @property
    def linear_properties(self) -> LinearProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Frame | None = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def darts(self) -> list[int]: ...
    def vertices(self) -> list[Vertex]: ...
    def faces(self) -> list[Face]: ...
    def sheets(self) -> list[Sheet]: ...

