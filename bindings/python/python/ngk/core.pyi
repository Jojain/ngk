"""Native NGK bindings used by the structured Python facade."""

from typing import Any, Optional, TypeAlias

class Model:
    @staticmethod
    def deserialize(serialized: str) -> Model: ...
    def serialize(self) -> str: ...
    @property
    def dimension(self) -> int: ...
    @property
    def involution_count(self) -> int: ...
    @property
    def dart_count(self) -> int: ...
    def darts(self) -> list[int]: ...
    def alpha(self, dimension: int, dart: int) -> int: ...
    def cells(self, dimension: int) -> list[int]: ...
    def cell_darts(self, dart: int, dimension: int) -> list[int]: ...
    def cell_representative(self, dart: int, dimension: int) -> int: ...
    def vertices(self) -> list[Vertex]: ...
    def edges(self) -> list[Edge]: ...
    def profiles(self) -> list[Profile]: ...
    def faces(self) -> list[Face]: ...
    def sheets(self) -> list[Sheet]: ...
    def solids(self) -> list[Solid]: ...

class _Topology:
    @property
    def model(self) -> Model: ...
    @property
    def key(self) -> str: ...
    @property
    def dart_id(self) -> int: ...
    def isolated(self) -> Any: ...
    def reversed(self) -> Any: ...

class Vertex(_Topology):
    @property
    def point(self) -> Optional[Point]: ...
    def edges(self) -> list[Edge]: ...
    def faces(self) -> list[Face]: ...

class Edge(_Topology):
    @property
    def start(self) -> Vertex: ...
    @property
    def end(self) -> Vertex: ...
    @property
    def length(self) -> Optional[float]: ...
    @property
    def curve(self) -> Optional[Curve]: ...
    @property
    def linear_properties(self) -> LinearProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Optional[Frame] = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def vertices(self) -> list[Vertex]: ...
    def faces(self) -> list[Face]: ...

class Profile(_Topology):
    @property
    def length(self) -> float: ...
    @property
    def linear_properties(self) -> LinearProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Optional[Frame] = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def edges(self) -> list[Edge]: ...
    def vertices(self) -> list[Vertex]: ...

class Loop(_Topology):
    def edges(self) -> list[Edge]: ...
    def vertices(self) -> list[Vertex]: ...

class Face(_Topology):
    @property
    def surface(self) -> Surface: ...
    # The face's own normal at (u, v) on its surface: outward for a face of a
    # solid, and opposite to surface.normal_at(u, v) where the face is reversed
    # against its surface. (u, v) is not tested against the face's loops.
    def normal_at(self, u: float, v: float) -> Vector: ...
    @property
    def outer_loop(self) -> Loop: ...
    def loops(self) -> list[Loop]: ...
    @property
    def area(self) -> float: ...
    @property
    def surface_properties(self) -> SurfaceProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Optional[Frame] = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def edges(self) -> list[Edge]: ...
    def vertices(self) -> list[Vertex]: ...

class Sheet(_Topology):
    @property
    def area(self) -> float: ...
    @property
    def surface_properties(self) -> SurfaceProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Optional[Frame] = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def faces(self) -> list[Face]: ...
    def edges(self) -> list[Edge]: ...

class Shell(_Topology):
    def faces(self) -> list[Face]: ...

class Solid(_Topology):
    @property
    def outer_shell(self) -> Shell: ...
    @property
    def face_count(self) -> int: ...
    @property
    def edge_count(self) -> int: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def area(self) -> float: ...
    @property
    def surface_properties(self) -> SurfaceProperties: ...
    @property
    def volume(self) -> float: ...
    @property
    def volume_properties(self) -> VolumeProperties: ...
    # The tightest box along the world axes, or along `frame`'s axes when given.
    def bounding_box(self, frame: Optional[Frame] = None) -> BoundingBox: ...
    # The smallest exact box over a fixed list of candidate frames, centred on
    # the box, axes from the longest extent to the shortest.
    def oriented_bounding_box(self) -> BoundingBox: ...
    def shells(self) -> list[Shell]: ...
    def faces(self) -> list[Face]: ...
    def edges(self) -> list[Edge]: ...
    def vertices(self) -> list[Vertex]: ...

# Measures are at density one; inertia is the centroidal tensor, row by row.
class LinearProperties:
    @property
    def length(self) -> float: ...
    @property
    def centroid(self) -> Point: ...
    @property
    def inertia(self) -> tuple[float, float, float, float, float, float, float, float, float]: ...

class SurfaceProperties:
    @property
    def area(self) -> float: ...
    @property
    def centroid(self) -> Point: ...
    @property
    def inertia(self) -> tuple[float, float, float, float, float, float, float, float, float]: ...

class VolumeProperties:
    @property
    def volume(self) -> float: ...
    @property
    def centroid(self) -> Point: ...
    @property
    def inertia(self) -> tuple[float, float, float, float, float, float, float, float, float]: ...

class Bound:
    Min: Bound
    Max: Bound

# A box given by a frame and a range along each of its axes. `min` and `max`
# are the corners at the low and high end of every range: in the world frame,
# the component-wise minimum and maximum.
class BoundingBox:
    @property
    def frame(self) -> Frame: ...
    @property
    def min(self) -> Point: ...
    @property
    def max(self) -> Point: ...
    @property
    def center(self) -> Point: ...
    @property
    def size(self) -> Vector: ...
    @property
    def x_size(self) -> float: ...
    @property
    def y_size(self) -> float: ...
    @property
    def z_size(self) -> float: ...
    @property
    def diagonal_length(self) -> float: ...
    def corner(self, x: Bound, y: Bound, z: Bound) -> Point: ...
    # x slowest and z fastest, each from its minimum to its maximum.
    def corners(self) -> list[Point]: ...

class Point:
    def __init__(self, x: float, y: float, z: float) -> None: ...
    def as_tuple(self) -> tuple[float, float, float]: ...

class Vector:
    def __init__(self, x: float, y: float, z: float) -> None: ...
    def as_tuple(self) -> tuple[float, float, float]: ...

class Point2:
    def __init__(self, x: float, y: float) -> None: ...
    def as_tuple(self) -> tuple[float, float]: ...

class Vector2(Point2): ...

class Axis:
    def __init__(self, origin: Point, direction: Vector) -> None: ...

class Frame:
    @staticmethod
    def xyz() -> Frame: ...
    @staticmethod
    def from_xy(origin: Point, x_dir: Vector, y_dir: Vector) -> Frame:
        """Builds a frame from its x and y axes, used as given (only normalized); z completes the right-handed frame.

        Raises ValueError when a direction is zero, or the two are parallel or not perpendicular.
        """
    @staticmethod
    def from_xz(origin: Point, x_dir: Vector, z_dir: Vector) -> Frame:
        """Builds a frame from its x and z axes, used as given (only normalized); y completes the right-handed frame.

        Raises ValueError when a direction is zero, or the two are parallel or not perpendicular.
        """
    @staticmethod
    def from_yz(origin: Point, y_dir: Vector, z_dir: Vector) -> Frame:
        """Builds a frame from its y and z axes, used as given (only normalized); x completes the right-handed frame.

        Raises ValueError when a direction is zero, or the two are parallel or not perpendicular.
        """

class Line: ...
class Circle: ...
class Ellipse: ...
class NurbsCurve: ...
class Plane:
    def __init__(self, origin: Point, x_dir: Vector, normal: Vector) -> None:
        """Builds a plane from its x direction and normal, used as given (only normalized).

        Raises ValueError when a direction is zero, or x_dir is parallel or not perpendicular to normal.
        """
    @staticmethod
    def xy() -> Plane: ...
    @staticmethod
    def xz() -> Plane: ...
    @staticmethod
    def yz() -> Plane: ...
    @property
    def origin(self) -> Point: ...
    @property
    def x_dir(self) -> Vector: ...
    @property
    def y_dir(self) -> Vector: ...
    @property
    def normal(self) -> Vector: ...
    def point_at(self, u: float, v: float) -> Point: ...
    def normal_at(self, u: float, v: float) -> Vector: ...
class Rigid:
    @staticmethod
    def identity() -> Rigid: ...
    @staticmethod
    def translation(offset: Vector) -> Rigid: ...
    @staticmethod
    def rotation(axis: Axis, angle: float) -> Rigid: ...
    @staticmethod
    def between_frames(from_frame: Frame, to_frame: Frame) -> Rigid: ...
    def compose(self, other: Rigid) -> Rigid: ...
    def inverse(self) -> Rigid: ...
    def apply(self, value: Point) -> Point: ...
    def apply_vector(self, value: Vector) -> Vector: ...
class Cylinder: ...
class Sphere: ...
class Cone: ...
class Torus: ...
class RuledSurface: ...
class SurfaceOfRevolution: ...
class NurbsSurface: ...

Curve: TypeAlias = Line | Circle | NurbsCurve
Surface: TypeAlias = Plane | Cylinder | Sphere | Cone | RuledSurface | SurfaceOfRevolution | NurbsSurface

class StepImport:
    solids: list[Solid]
    skipped: list[str]

def read_step(path: str) -> StepImport: ...
def step_from_string(text: str) -> StepImport: ...
def step_to_string(solid: Solid, name: str | None = None) -> str: ...
def write_step(solid: Solid, path: str | None = None, name: str | None = None) -> str: ...
def _to_tcv_json(obj: object, name: str | None = None, color: str = "#e8b024", alpha: float = 1.0) -> str: ...
