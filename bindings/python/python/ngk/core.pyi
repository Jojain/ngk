_Surface: TypeAlias = Plane | Cylinder | Sphere | Cone | Torus | RuledSurface | SurfaceOfRevolution | NurbsSurface

class StepImport:
    def __len__(self) -> int: ...
    @property
    def solids(self) -> list[Solid]:
        """The solids the file yielded, in the order it named them."""
    @property
    def skipped(self) -> list[str]:
        """One line per thing that could not be carried across faithfully."""

