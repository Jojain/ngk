    @property
    def knots(self) -> list[float]: ...
    # Each control point with its weight.
    @property
    def control_points(self) -> list[tuple[Point, float]]: ...
    def point_at(self, u: float) -> Point: ...

class Plane:
    def project(
        self,
        source: Point | tuple[float, float, float] | _Curve | Edge | Profile,
        along: Vector | None = None,
        tolerance: float | None = None,
    ) -> PointProjection | CurveProjection: ...
    def __new__(cls, origin: Point, x_dir: Vector, normal: Vector) -> Self:
        """Builds a plane from its x direction and normal, used as given (only normalized).

        Raises ValueError when a direction is zero, or x_dir is parallel or not perpendicular to normal.
        """
    @staticmethod
    def xy() -> Plane: ...
    @staticmethod
    def xz() -> Plane: ...
    @staticmethod
    def yz() -> Plane: ...
    @property
    def origin(self) -> Point: ...
    @property
    def x_dir(self) -> Vector: ...
    @property
    def y_dir(self) -> Vector: ...
    @property
    def normal(self) -> Vector: ...
    def point_at(self, u: float, v: float) -> Point: ...
    def normal_at(self, _u: float, _v: float) -> Vector: ...

class Rigid:
    @staticmethod
    def identity() -> Rigid: ...
    @staticmethod
    def translation(offset: Vector) -> Rigid: ...
    @staticmethod
    def rotation(axis: Axis, angle: float) -> Rigid: ...
    @staticmethod
    def between_frames(from_frame: Frame, to_frame: Frame, /) -> Rigid: ...
    def compose(self, other: Rigid) -> Rigid: ...
    def inverse(self) -> Rigid: ...
    def apply(self, value: Point) -> Point: ...
    def apply_vector(self, value: Vector) -> Vector: ...

